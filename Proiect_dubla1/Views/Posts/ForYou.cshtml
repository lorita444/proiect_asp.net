@model List<Proiect_dubla1.Models.Post>

<h2 style="margin-top:15px;">For you</h2>

@if (Model.Count == 0)
{
    <div style="margin-top:15px; color:#666;">
        Nu urmărești pe nimeni sau încă nu au postat nimic.
    </div>
}
else
{
    <div class="profile-posts-container">
        @foreach (var post in Model)
        {
            <div class="profile-post-card">

                <div class="post-header">
                    <div class="post-left">
                        <span class="post-user">@post.User?.UserName</span>
                        <span class="post-type">
                            @(post.Type == Proiect_dubla1.Models.PostType.Thought ? "Thought" : "Post")
                        </span>
                    </div>

                    <div class="post-date">
                        @post.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>

                @if (post.Type == Proiect_dubla1.Models.PostType.Thought)
                {
                    <div class="post-body thought-body">
                        @post.Content
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                    {
                        <img class="post-image" src="@post.ImagePath" alt="Post image" />
                    }

                    @if (!string.IsNullOrWhiteSpace(post.Caption))
                    {
                        <div class="post-body post-caption">
                            @post.Caption
                        </div>
                    }
                }

                <div style="padding: 10px 14px;">
                    <a class="btn btn-outline-dark btn-sm"
                       asp-controller="Users"
                       asp-action="Details"
                       asp-route-id="@post.UserId">
                        View profile
                    </a>
                </div>
            </div>
        }
    </div>
}
