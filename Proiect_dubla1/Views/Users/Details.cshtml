@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@model Proiect_dubla1.Models.User

<div class="profile-container">

    <div class="profile-header-card">
        <div class="avatar-wrap">
            <img class="profile-avatar" src="@Model.ProfileImagePath" />

            <div class="profile-firstname">@Model.FirstName</div>
            <div class="profile-lastname">@Model.LastName</div>
        </div>

        <div class="profile-info">
            <span class="profile-username">@Model.UserName</span>

            <div class="profile-stats">
                <a class="text-dark" style="text-decoration:none;"
                   asp-controller="Users" asp-action="Followers" asp-route-id="@Model.Id">
                    <strong>@ViewBag.FollowersCount</strong> followers
                </a>

                <a class="text-dark" style="text-decoration:none; margin-left:12px;"
                   asp-controller="Users" asp-action="Following" asp-route-id="@Model.Id">
                    <strong>@ViewBag.FollowingCount</strong> following
                </a>
            </div>


            @if (User.Identity.IsAuthenticated && !(bool)ViewBag.IsOwnProfile)
            {
                if ((bool)ViewBag.IsFollowing)
                {
                    <form asp-controller="Follows" asp-action="Unfollow" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-dark">Unfollow</button>
                    </form>
                }
                else
                {
                    <form asp-controller="Follows" asp-action="Follow" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-dark">Follow</button>
                    </form>
                }
            }

            <div class="profile-meta">
                <span>@Model.Age</span>
                <span>@Model.RelationshipStatus</span>
                <span>@Model.City, @Model.Country</span>
            </div>

            <p class="profile-bio">@Model.Description</p>

            @if (User.Identity.IsAuthenticated && UserManager.GetUserId(User) == Model.Id)
            {
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
                    <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Id">Edit profile</a>

                    <a class="btn btn-dark" asp-controller="Posts" asp-action="CreatePost">Add Post</a>
                    <a class="btn btn-outline-dark" asp-controller="Posts" asp-action="CreateThought">Add Thought</a>
                </div>
            }
        </div>
    </div>

    <h2 class="posts-title">@Model.FirstName's Posts</h2>

    <div class="profile-posts-container">
        @foreach (var post in ViewBag.Posts)
        {
            <div class="profile-post-card">

                <!-- HEADER: user + tip + data -->
                <div class="post-header">
                    <div class="post-left">
                        <span class="post-user">@Model.UserName</span>

                        <span class="post-type">
                            @(post.Type == Proiect_dubla1.Models.PostType.Thought ? "Thought" : "Post")
                        </span>
                    </div>

                    <div class="post-date">
                        @post.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>

                <!-- BODY -->
                @if (post.Type == Proiect_dubla1.Models.PostType.Thought)
                {
                    <div class="post-body thought-body">
                        @post.Content
                    </div>
                }
                else
                {
                    @* Imagine crop + fallback *@
                    if (!string.IsNullOrWhiteSpace((string)post.ImagePath))
                    {
                        <img class="post-image" src="@post.ImagePath" alt="Post image" />
                    }
                    else
                    {
                        <div class="post-body" style="color:#a00;">
                            Imagine lipsă / path invalid
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace((string)post.Caption))
                    {
                        <div class="post-body post-caption">
                            @post.Caption
                        </div>
                    }
                }
            </div>
        }
    </div>

</div>
