@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@model Proiect_dubla1.Models.User

<div class="profile-container">

    <div class="profile-header-card">
        <div class="avatar-wrap">
            <img class="profile-avatar" src="@Model.ProfileImagePath" />

            <div class="profile-firstname">@Model.FirstName</div>
            <div class="profile-lastname">@Model.LastName</div>
        </div>

        <div class="profile-info">
      
            <span class="profile-username">@Model.UserName</span>

            <div class="profile-stats">
                <span><strong>@ViewBag.FollowersCount</strong> followers</span>
                <span><strong>@ViewBag.FollowingCount</strong> following</span>
            </div>

            @if (User.Identity.IsAuthenticated && !(bool)ViewBag.IsOwnProfile)
            {
                if ((bool)ViewBag.IsFollowing)
                {
                    <form asp-controller="Follows" asp-action="Unfollow" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-dark">Unfollow</button>
                    </form>
                }
                else
                {
                    <form asp-controller="Follows" asp-action="Follow" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-dark">Follow</button>
                    </form>
                }
            }



            <div class="profile-meta">
                <span>@Model.Age</span>
                <span> @Model.RelationshipStatus</span>
                <span>@Model.City, @Model.Country</span>
                
            </div>

            <p class="profile-bio">@Model.Description</p>

            @if (User.Identity.IsAuthenticated && UserManager.GetUserId(User) == Model.Id)
            {
                <a class="btn" asp-action="Edit" asp-route-id="@Model.Id">
                    Edit profile
                </a>
            }
        </div>
    </div>

    <h2 class="posts-title">@Model.FirstName's Posts</h2>

    <div class="profile-posts-grid">
        @foreach (var post in ViewBag.Posts)
        {
            <div class="profile-post-card">
                <img src="@post.ImagePath" />
            </div>
        }
    </div>

</div>
