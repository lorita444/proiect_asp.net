@model IEnumerable<Proiect_dubla1.Models.User>


<form class="search_form" method="get">
    <input type="text" class="search_bar" name="search" value="@ViewBag.Search" placeholder="Type a name" />
    <button type="submit" class="btn">Search</button>
</form>
<div class="text_search">Users</div>
<table class="table tabel-cautare">
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@(user.FirstName + " " + user.LastName)</td>

                <td>
                    <a asp-action="Details" asp-route-id="@user.Id">Profil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
